# Copy to .env and change the values. .env is not committed.
POSTGRES_DB=pjm
POSTGRES_USER=pjm
# Local dev: keep "pjm" to match backend/src/ProjectManager.Api/appsettings.Development.json
POSTGRES_PASSWORD=pjm
# HMAC-SHA512 signing key, at least 64 characters. Generate with: openssl rand -base64 64 | tr -d '\n'
TOKEN_KEY=
WEB_PORT=8080
DB_PORT=5432
